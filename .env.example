# ===========================================================================
# AI Career Agent - environment template. Copy to `.env` and fill in values.
# NEVER commit the real .env file. Use a secrets manager in staging/production.
# ===========================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
BRAND_NAME=AI Career Agent         # product name shown in UI and emails (configurable)
BRAND_SUPPORT_EMAIL=support@example.com
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Security (REQUIRED in staging/production) -----------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false                # must be true behind HTTPS
COOKIE_DOMAIN=

# --- Database / queue -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false     # true = run tasks inline (no worker needed, dev only)

# --- Object storage (S3 compatible: AWS S3, MinIO, Cloudflare R2, ...) -----------------
STORAGE_BACKEND=local              # local (dev only) | s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=career-agent
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
LOCAL_STORAGE_PATH=.local-storage
MAX_UPLOAD_MB=8

# --- AI -----------------------------------------------------------------------------
AI_PROVIDER=mock                   # mock (offline sandbox, clearly labelled in the UI) | openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o

# --- Email --------------------------------------------------------------------------
EMAIL_PROVIDER=console             # console (dev: prints emails to the log) | smtp
EMAIL_FROM=AI Career Agent <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---------------------
# Authorised redirect URI: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments -----------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local simulation of a payment provider. Refused in staging/production.
BILLING_SANDBOX_ENABLED=true
BILLING_SANDBOX_SECRET=sandbox-webhook-secret

# --- Job sources --------------------------------------------------------------------
ENABLE_MOCK_CONNECTOR=true         # sample jobs for development; disable in production
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Application automation ---------------------------------------------------------
# Comma-separated domains where automated form filling is allowed. Only add sites whose
# terms permit it or that you operate yourself. Never add job boards that forbid bots.
AUTOMATION_ALLOWED_DOMAINS=localhost,127.0.0.1
AUTOMATION_HEADLESS=true
AUTOMATION_MAX_ATTEMPTS=3

# --- Rate limiting ------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=240

# --- Frontend (public values only - never put secrets here) -------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BRAND_NAME=AI Career Agent
